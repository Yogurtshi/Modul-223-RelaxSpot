<div class="dashboard-heading">
  <div>
    <p class="eyebrow">Moderation space</p>
    <h1>Dashboard</h1>
    <p class="page-intro">Keep an eye on community activity, new suggestions, and account access.</p>
  </div>
</div>

<div class="dashboard-grid">
  <section class="dashboard-panel dashboard-panel--wide">
    <div class="dashboard-panel__heading">
      <div>
        <p class="eyebrow">PaperTrail</p>
        <h2>Recent activity</h2>
      </div>
      <span class="dashboard-count"><%= @recent_activity.size %></span>
    </div>

    <% if @recent_activity.present? %>
      <ul class="activity-list">
        <% @recent_activity.each do |version| %>
          <% item = version.item %>
          <% item_name = item.respond_to?(:name) ? item.name : version.item_type %>
          <% action = version.event == "create" ? "created" : version.event == "update" ? "updated" : "deleted" %>
          <% actor = @activity_users[version.whodunnit]&.name || "System" %>

          <li>
            <div>
              <strong><%= version.item_type %></strong>
              <span><%= action %> <%= item_name.present? ? "#{item_name}" : "" %> by <%= actor %></span>
            </div>
            <small><%= version.created_at.strftime("%d.%m.%Y %H:%M") %></small>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="dashboard-empty">No recent activity yet.</p>
    <% end %>
  </section>

  <section class="dashboard-panel">
    <div class="dashboard-panel__heading">
      <div>
        <p class="eyebrow">Community</p>
        <h2>Users</h2>
      </div>
      <span class="dashboard-count"><%= @users.size %></span>
    </div>

    <ul class="dashboard-list">
      <% @users.each do |user| %>
        <% if current_user.admin? %>
          <li class="dashboard-user-card">
            <%= link_to admin_user_path(user), class: "dashboard-user-card__link" do %>
              <strong><%= user.name %></strong>
              <span><%= user.role.humanize %> · <%= user.locked? ? "Blocked" : "Active" %></span>
            <% end %>
          </li>
        <% else %>
          <li class="dashboard-user-card">
            <div class="dashboard-user-card__link">
              <strong><%= user.name %></strong>
              <span><%= user.role.humanize %> · <%= user.locked? ? "Blocked" : "Active" %></span>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <section class="dashboard-panel">
    <div class="dashboard-panel__heading">
      <div>
        <p class="eyebrow">Needs review</p>
        <h2>Place suggestions</h2>
      </div>
      <span class="dashboard-count"><%= @pending_places.size %></span>
    </div>

    <% if @pending_places.present? %>
      <ul class="dashboard-list">
        <% @pending_places.each do |place| %>
          <li class="dashboard-suggestion-card">
            <%= link_to moderation_place_path(place), class: "dashboard-suggestion-card__link" do %>
              <strong><%= place.name %></strong>
              <span><%= place.category.humanize %> · suggested by <%= place.proposed_by.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="dashboard-empty">No place suggestions are waiting for review.</p>
    <% end %>
  </section>

  <section class="dashboard-panel">
    <div class="dashboard-panel__heading">
      <div>
        <p class="eyebrow">Needs review</p>
        <h2>Status reports</h2>
      </div>
      <span class="dashboard-count"><%= @pending_status_reports.size %></span>
    </div>

    <% if @pending_status_reports.present? %>
      <ul class="dashboard-list">
        <% @pending_status_reports.each do |status_report| %>
          <li class="dashboard-suggestion-card">
            <%= link_to moderation_status_report_path(status_report), class: "dashboard-suggestion-card__link" do %>
              <strong><%= status_report.place.name %></strong>
              <span><%= status_report.reported_status.humanize %><%= " · hours changed" if status_report.reported_opening_hours.present? %> · reported by <%= status_report.user.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="dashboard-empty">No status reports are waiting for review.</p>
    <% end %>
  </section>
</div>
