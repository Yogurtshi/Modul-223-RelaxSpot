<section class="form-page">
	<div class="form-heading">
		<p class="eyebrow">Moderation</p>
		<h1>Edit <%= @place.name %></h1>
		<p class="page-intro">Update the place details before saving. The place is locked for other moderators while you edit it.</p>
	</div>

	<%= form_with model: @place, url: moderation_place_path(@place), method: :patch, class: "place-form" do |form| %>
		<% if @place.errors.any? %>
			<div class="form-errors">
				<strong>Please check the form:</strong>
				<ul>
					<% @place.errors.full_messages.each do |message| %>
						<li><%= message %></li>
					<% end %>
				</ul>
			</div>
		<% end %>

		<div class="form-field-grid">
			<div class="field-group field-group--wide">
				<%= form.label :name, "Place name" %>
				<%= form.text_field :name, autofocus: true %>
			</div>

			<div class="field-group">
				<%= form.label :category %>
				<%= form.select :category, Place.categories.keys.map { |category| [ category.humanize, category ] } %>
			</div>

			<div class="field-group">
				<%= form.label :status %>
				<%= form.select :status, Place.statuses.keys.map { |status| [ status.humanize, status ] } %>
			</div>

			<div class="field-group">
				<%= form.label :capacity %>
				<%= form.number_field :capacity, min: 1 %>
			</div>

			<div class="field-group">
				<%= form.label :latitude %>
				<%= form.number_field :latitude, step: "any" %>
			</div>

			<div class="field-group">
				<%= form.label :longitude %>
				<%= form.number_field :longitude, step: "any" %>
			</div>

			<div class="field-group field-group--wide">
				<%= form.label :opening_hours, "Opening hours (optional)" %>
				<%= form.text_field :opening_hours %>
			</div>
		</div>

		<div class="place-form__actions">
			<%= link_to "Cancel", moderation_place_path(@place), class: "secondary-button" %>
			<%= form.submit "Save place", class: "primary-button" %>
		</div>
	<% end %>
</section>
