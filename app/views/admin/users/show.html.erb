<div class="review-page">
  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= @user.role.humanize %></p>
      <h1><%= @user.name %></h1>
      <p class="page-intro"><%= @user.email %></p>
    </div>

    <span class="status-badge <%= @user.locked? ? 'status-badge--negative' : 'status-badge--positive' %>">
      <%= @user.locked? ? "Blocked" : "Active" %>
    </span>
  </div>

  <section class="review-details" aria-label="User details">
    <div class="review-detail-item">
      <span class="detail-label">Email</span>
      <strong><%= @user.email %></strong>
    </div>
    <div class="review-detail-item">
      <span class="detail-label">Role</span>
      <strong><%= @user.role.humanize %></strong>
    </div>
  </section>

  <div class="review-actions">
    <%= button_to "Promote to moderator", promote_admin_user_path(@user), method: :post, class: "small-button small-button--soft" %>
    <%= button_to "Demote to user", demote_admin_user_path(@user), method: :post, class: "small-button small-button--soft" %>
    <% if @user.locked? %>
      <%= button_to "Unblock", unlock_admin_user_path(@user), method: :post, class: "small-button small-button--positive" %>
    <% else %>
      <%= button_to "Block", lock_admin_user_path(@user), method: :post, class: "small-button small-button--danger" %>
    <% end %>
  </div>
</div>