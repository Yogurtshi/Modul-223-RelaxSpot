<section class="form-page check-in-page">
  <div class="form-heading">
    <p class="eyebrow">Take your time</p>
    <h1>Check in at <%= @place.name %></h1>
    <p class="page-intro">Choose how long you expect to stay. You can leave whenever you are ready.</p>
  </div>

  <div class="check-in-place-card">
    <div>
      <span class="detail-label">Current spot</span>
      <strong><%= @place.category.humanize %></strong>
    </div>
    <div>
      <span class="detail-label">Capacity</span>
      <strong><%= @place.capacity %> people</strong>
    </div>
    <div>
      <span class="detail-label">Opening hours</span>
      <strong><%= @place.opening_hours.presence || "Not specified" %></strong>
    </div>
  </div>

  <%= form_with url: check_ins_path, scope: :check_in, class: "check-in-form" do |form| %>
    <% if @check_in.errors.any? %>
      <div class="form-errors">
        <strong>We could not check you in:</strong>
        <ul>
          <% @check_in.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :place_id, value: @place.id %>

    <div class="field-group">
      <%= form.label :expected_minutes, "Expected stay in minutes" %>
      <%= form.number_field :expected_minutes, min: 1, value: 30, autofocus: true %>
      <small class="field-help">You can check in for as little or as much time as you need.</small>
    </div>

    <div class="check-in-form__actions">
      <%= link_to "Back to place", place_path(@place), class: "secondary-button" %>
      <%= form.submit "Check in", class: "primary-button" %>
    </div>
  <% end %>
</section>