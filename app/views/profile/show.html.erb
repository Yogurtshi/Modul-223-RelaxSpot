<div class="page-heading">
	<div>
		<p class="eyebrow">Your space</p>
		<h1>Profile</h1>
		<p class="page-intro">Keep your RelaxSpot details up to date.</p>
	</div>

	<%= link_to "Edit profile", edit_profile_path, class: "action-button" %>
</div>

<section class="profile-summary" aria-label="Profile details">
	<div class="profile-detail">
		<span class="detail-label">Name</span>
		<strong><%= @user.name %></strong>
	</div>
	<div class="profile-detail">
		<span class="detail-label">Email</span>
		<strong><%= @user.email %></strong>
	</div>
</section>