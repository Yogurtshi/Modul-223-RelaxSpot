<section class="form-page profile-form-page">
  <div class="form-heading">
    <p class="eyebrow">Your details</p>
    <h1>Edit profile</h1>
    <p class="page-intro">Keep your name and contact details current. You can also choose a new password below.</p>
  </div>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "profile-form" do |form| %>
    <% if @user.errors.any? %>
      <div class="form-errors">
        <strong>Please check the form:</strong>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-field-grid">
      <div class="field-group field-group--wide">
        <%= form.label :name %>
        <%= form.text_field :name, autocomplete: "name", autofocus: true %>
      </div>

      <div class="field-group field-group--wide">
        <%= form.label :email %>
        <%= form.email_field :email, autocomplete: "email" %>
      </div>

      <div class="profile-form__divider field-group--wide">
        <span>Password changes</span>
        <small>Enter your current password to confirm any account changes.</small>
      </div>

      <div class="field-group">
        <%= form.label :current_password %>
        <%= form.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="field-group">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, autocomplete: "new-password" %>
      </div>
    </div>

    <div class="profile-form__actions">
      <%= link_to "Cancel", profile_path, class: "secondary-button" %>
      <%= form.submit "Save changes", class: "primary-button" %>
    </div>
  <% end %>
</section>