<div class="page-heading">
  <div>
    <p class="eyebrow">Find your pause</p>
    <h1>RelaxSpot places</h1>
    <p class="page-intro">Explore calm, approved places and find your next moment to reset.</p>
  </div>

  <%= link_to "Suggest a place", new_place_path, class: "action-button" %>
</div>

<%= form_with url: places_path, method: :get, scope: nil, class: "place-filters" do |form| %>
  <div class="field-group">
    <%= form.label :search, "Search by name" %>
    <%= form.search_field :search, value: @search, placeholder: "e.g. garden" %>
  </div>

  <div class="field-group">
    <%= form.label :category %>
    <%= form.select :category, options_for_select([["All categories", ""]] + Place.categories.keys.map { |category| [ category.humanize, category ] }, @category) %>
  </div>

  <div class="field-group">
    <%= form.label :status %>
    <%= form.select :status, options_for_select([["All statuses", ""]] + Place.statuses.keys.map { |status| [ status.humanize, status ] }, @status) %>
  </div>

  <div class="place-filters__actions">
    <%= form.submit "Filter places", class: "primary-button" %>
    <%= link_to "Clear", places_path, class: "secondary-button" %>
  </div>
<% end %>

<% if @places.any? %>
  <div class="spot-grid">
    <% @places.each do |place| %>
      <article class="spot-card">
        <%= link_to "", place_path(place), class: "spot-card__cover-link", aria: { label: "View #{place.name}" } %>

        <div class="spot-card__actions">
          <% if current_user %>
            <%= link_to new_status_report_path(place_id: place.id), class: "small-button small-button--soft spot-card__report", title: "Report #{place.name}", aria: { label: "Report #{place.name}" } do %>
              <span aria-hidden="true">⚑</span>
              <span class="visually-hidden">Report</span>
            <% end %>
          <% else %>
            <%= link_to new_session_path, class: "small-button small-button--soft spot-card__report", title: "Log in to report a place", aria: { label: "Log in to report a place" } do %>
              <span aria-hidden="true">⚑</span>
              <span class="visually-hidden">Report</span>
            <% end %>
          <% end %>
        </div>

        <h2><%= place.name %></h2>
        <p class="spot-card__capacity">
          <strong><%= @active_check_ins_by_place.fetch(place.id, 0) %>/<%= place.capacity %></strong>
          people currently here
        </p>

        <div class="spot-card__topline">
          <span class="spot-card__category"><%= place.category.humanize %></span>
          <span class="spot-card__status"><%= place.status.humanize %></span>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <h2>No approved places yet</h2>
    <p>Be the first to suggest a peaceful place for the community.</p>
    <%= link_to "Suggest a place", new_place_path, class: "action-button" %>
  </div>
<% end %>