<h1>RelaxSpot places</h1>

<%= link_to "Suggest a place", new_place_path %>

<% if @places.any? %>
  <ul>
    <% @places.each do |place| %>
      <li>
        <h2><%= link_to place.name, place_path(place) %></h2>
        <p>Category: <%= place.category.humanize %></p>
        <p>Status: <%= place.status.humanize %></p>
        <p>Capacity: <%= place.capacity %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No approved places yet.</p>
<% end %>